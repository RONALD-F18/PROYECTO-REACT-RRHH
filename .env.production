# Producción — https://talentsphere.cloud (Laravel + React en el mismo dominio)
# Build: npm run build

VITE_API_URL=https://talentsphere.cloud/api/v1

# Formulario de recuperación en Laravel (Blade). El correo también usa reset-password.html.
VITE_RECUPERAR_CONTRASENA_URL=https://talentsphere.cloud/reset-password.html

# Si el rewrite de Apache/Nginx aún no enruta /api/v1, descomenta la línea siguiente y comenta VITE_API_URL:
# VITE_API_URL=https://talentsphere.cloud/public/index.php/api/v1
