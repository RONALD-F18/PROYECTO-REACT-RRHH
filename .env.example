# URL base del API Laravel (sin barra final)
VITE_API_URL=http://localhost:8000/api/v1

# Opcional: tiempo máximo de espera por petición (ms). Por defecto 60000.
# VITE_API_TIMEOUT_MS=90000

# Opcional: URL del formulario de recuperación en Laravel (Blade), p. ej. http://localhost:8000/forgot-password
# Si la defines, "¿Olvidaste tu contraseña?" abre esa página. Si la dejas vacía, se usa /recuperar-contrasena en React (POST /forgot-password).
# VITE_RECUPERAR_CONTRASENA_URL=http://localhost:8000/forgot-password
