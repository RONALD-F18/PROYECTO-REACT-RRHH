# URL base del API Laravel (sin barra final). Debe terminar en /api/v1
# Opción A — mismo host que Vite (recomendado en desarrollo): activa el proxy en vite.config.js
#   y evita CORS/cookies entre puertos.
# VITE_API_URL=/api/v1
# VITE_PROXY_TARGET=http://127.0.0.1:8000
#
# Opción B — Laravel en otro origen (puerto u host distinto):
VITE_API_URL=http://localhost:8000/api/v1

# Tiempo máximo de espera por petición (ms). Por defecto en código: 120000 (2 min).
# Sube este valor si ves "tiempo agotado" con listados o Docker lentos (p. ej. 180000 o 300000).
# VITE_API_TIMEOUT_MS=180000

# Opcional: URL del formulario de recuperación en Laravel (Blade), p. ej. http://localhost:8000/forgot-password
# Si la defines, "¿Olvidaste tu contraseña?" abre esa página. Si la dejas vacía, se usa /recuperar-contrasena en React (POST /forgot-password).
# VITE_RECUPERAR_CONTRASENA_URL=http://localhost:8000/forgot-password
