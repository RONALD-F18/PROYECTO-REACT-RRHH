# URL base del API Laravel (sin barra final). Debe terminar en /api/v1
#
# Desarrollo — Opción A (recomendada): proxy de Vite hacia Laravel
# VITE_API_URL=/api/v1
# VITE_PROXY_TARGET=http://127.0.0.1:8000
#
# Desarrollo — Opción B: Laravel en otro origen
VITE_API_URL=http://localhost:8000/api/v1

# Producción (copiar a .env.production antes de npm run build)
# VITE_API_URL=https://talentsphere.cloud/api/v1
# VITE_RECUPERAR_CONTRASENA_URL=https://talentsphere.cloud/reset-password.html
# Fallback si falla rewrite limpio en el servidor:
# VITE_API_URL=https://talentsphere.cloud/public/index.php/api/v1

# Tiempo máximo de espera por petición (ms). Por defecto en código: 120000 (2 min).
# VITE_API_TIMEOUT_MS=180000

# Recuperación de contraseña: enlace del login hacia el formulario Laravel (Blade).
# Si la defines, "¿Olvidaste tu contraseña?" abre esa URL. Si la dejas vacía, usa /recuperar-contrasena en React.
# Desarrollo: VITE_RECUPERAR_CONTRASENA_URL=http://localhost:8000/reset-password.html
# Producción: VITE_RECUPERAR_CONTRASENA_URL=https://talentsphere.cloud/reset-password.html
